---
interface Section { title: string; body: string; points?: string[] }
interface Props { eyebrow: string; title: string; intro: string; sections: Section[]; cta?: { label: string; href: string } }
const { eyebrow, title, intro, sections, cta } = Astro.props;
---
<main class="info-page">
  <header class="info-hero">
    <p>{eyebrow}</p>
    <h1>{title}</h1>
    <div class="info-hero-copy"><p>{intro}</p>{cta && <a href={cta.href}>{cta.label} <span aria-hidden="true">↗</span></a>}</div>
  </header>
  <div class="info-sections">
    {sections.map((section, index) => (
      <section class="info-section">
        <span>{String(index + 1).padStart(2, "0")}</span>
        <div><h2>{section.title}</h2><p>{section.body}</p>{section.points && <ul>{section.points.map(point => <li>{point}</li>)}</ul>}</div>
      </section>
    ))}
  </div>
</main>
