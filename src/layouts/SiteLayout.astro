---
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import WaitlistPopup from "../components/WaitlistPopup.astro";

interface Props {
  title: string;
  description: string;
  pageClass?: string;
}

const { title, description, pageClass = "" } = Astro.props;
const siteName = "Fylmer";
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://fylmer.com");
const socialImage = new URL("/og-fylmer.jpg", Astro.site ?? canonical);
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://fylmer.com/#organization",
      name: siteName,
      url: "https://fylmer.com/",
      logo: "https://fylmer.com/favicon.svg",
      description: "An AI-native filmmaking platform for story, continuity, generation, and review.",
    },
    {
      "@type": "WebSite",
      "@id": "https://fylmer.com/#website",
      url: "https://fylmer.com/",
      name: siteName,
      publisher: { "@id": "https://fylmer.com/#organization" },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("fylmer-theme");
          const theme = saved === "dark" || saved === "light"
            ? saved
            : (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          document.documentElement.dataset.theme = theme;
        } catch {}
      })();
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fylmer AI filmmaking platform" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <link rel="stylesheet" href="/styles.css" />
    <link rel="stylesheet" href="/inner.css" />
    <script is:inline src="/theme-toggle.js" defer></script>
    <script is:inline src="/retro-dither.js" defer></script>
  </head>
  <body class={pageClass}>
    <div class="site-shell">
      <SiteHeader />
      <slot />
      <SiteFooter />
      <WaitlistPopup />
    </div>
  </body>
</html>

<style is:global>
  .inner-global-nav {
    position: relative;
    top: auto;
    color: #111 !important;
    background: #fff !important;
  }
  :root[data-theme="dark"] .inner-global-nav {
    color: #f4f4f2 !important;
    background: #111 !important;
  }
  :root[data-theme="dark"] .inner-global-nav .brand-mark,
  :root[data-theme="dark"] .inner-global-nav .brand-mark span,
  :root[data-theme="dark"] .inner-global-nav .nav-links a,
  :root[data-theme="dark"] .inner-global-nav .nav-trigger,
  :root[data-theme="dark"] .inner-global-nav .login-link { color: #f4f4f2 !important; }
  :root[data-theme="dark"] .inner-global-nav .button-primary { color: #111 !important; background: #f4f4f2 !important; }
  :root[data-theme="dark"] .inner-global-nav .mobile-menu-toggle span { background: #f4f4f2 !important; }
  .inner-global-nav .nav-shell { width: 100%; }
  .inner-global-nav .brand-mark,
  .inner-global-nav .nav-links a,
  .inner-global-nav .nav-trigger,
  .inner-global-nav .login-link { color: #111 !important; }
  .inner-global-nav .brand-mark,
  .inner-global-nav .brand-mark span { color: #111 !important; text-shadow: none !important; }
  .inner-global-nav .button-primary { color: #111 !important; background: rgba(255,255,255,.86) !important; }
  .inner-global-nav .mobile-menu-toggle span { background: #111 !important; }
  .inner-page > main { display: block; }
</style>
